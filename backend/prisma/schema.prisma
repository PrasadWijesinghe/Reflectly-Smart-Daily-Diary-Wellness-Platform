datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int          @id @default(autoincrement())
  name           String
  email          String       @unique
  password       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  appLockEnabled Boolean      @default(false)
  appLockType    String?
  appLockHash    String?
  diaries        DailyDiary[]
}

model DailyDiary {
  id        Int      @id @default(autoincrement())
  date      DateTime
  content   String
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  moodScore Int?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      Tag[]
  images    DiaryImage[]

  @@unique([userId, date])
}

model DiaryImage {
  id           Int        @id @default(autoincrement())
  filename     String
  originalName String
  mimeType     String
  size         Int
  order        Int
  diaryId      Int
  diary        DailyDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model Tag {
  id      Int           @id @default(autoincrement())
  name    String        @unique
  icon    String
  color   String
  diaries DailyDiary[]
}

model Feedback {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

model WeeklySummary {
  id          Int      @id @default(autoincrement())
  userId      Int
  year        Int
  month       Int
  weekNumber  Int
  weekStart   DateTime
  weekEnd     DateTime
  dayCount    Int
  shortSummary String  @db.Text
  fullSummary String  @db.Text
  topTags     String   @db.Text
  mood        String
  entryCount  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year, month, weekNumber])
  @@index([userId])
}
