datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int          @id @default(autoincrement())
  name      String
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  pushToken String?
  diaries   DailyDiary[]
}

model DailyDiary {
  id        Int      @id @default(autoincrement())
  date      DateTime
  content   String
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      Tag[]

  @@unique([userId, date])
}

model Tag {
  id      Int           @id @default(autoincrement())
  name    String        @unique
  icon    String
  color   String
  diaries DailyDiary[]
}